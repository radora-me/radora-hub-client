# ==============================================================================
# Radora Hub - Frontend Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
# ==============================================================================

# Backend REST API URL (e.g. http://localhost:5000/api or https://your-backend.com/api)
VITE_API_BASE=http://localhost:5000/api

# WebSocket Server URL (e.g. http://localhost:5000 or https://your-backend.com)
VITE_SOCKET_URL=http://localhost:5000

# Application Details
VITE_APP_NAME="Radora Hub"
VITE_APP_ENV=development
